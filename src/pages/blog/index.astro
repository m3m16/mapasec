---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog · Miguel Ángel Pousibet" description="Write-ups técnicos y artículos sobre ciberseguridad, pentesting y CTFs.">
  <section class="min-h-screen pt-28 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="text-green text-sm font-mono mb-2">// blog</p>
      <h1 class="font-display font-bold text-3xl sm:text-4xl mb-4">Write-ups & Artículos</h1>
      <p class="text-text-muted mb-12">
        Resoluciones de máquinas, análisis de vulnerabilidades y notas técnicas.
      </p>

      <!-- Placeholder for future blog posts -->
      <div class="border border-border rounded-lg p-8 text-center bg-surface">
        <p class="text-text-muted text-sm font-mono">
          <span class="text-green">$</span> ls -la ./posts/
        </p>
        <p class="text-text-muted text-sm font-mono mt-2">
          total 0 — Próximamente...
        </p>
      </div>
    </div>
  </section>
</Layout>
