---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Not Found | m3m1g@sec">
  <section class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="max-w-xl w-full font-mono text-sm">

      <!-- Terminal window chrome -->
      <div class="flex items-center gap-2 px-4 py-3 bg-surface border border-border rounded-t-lg border-b-0">
        <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/50"></span>
        <span class="w-3 h-3 rounded-full bg-green/50"></span>
        <span class="text-text-muted text-xs ml-2 select-none">bash — m3m1g@sec: ~</span>
      </div>

      <!-- Terminal body -->
      <div class="bg-surface border border-border rounded-b-lg px-6 py-5 space-y-2">

        <!-- Line 1 — prompt + command -->
        <div class="terminal-line" style="animation-delay: 0.3s">
          <span class="text-text-muted">┌──(</span><span class="text-green">m3m1g㉿sec</span><span class="text-text-muted">)-[~]</span>
        </div>
        <div class="terminal-line" style="animation-delay: 0.5s">
          <span class="text-text-muted">└─$</span> <span class="text-text">GET /this-page</span>
        </div>

        <!-- Line 2 — error response -->
        <div class="terminal-line text-red-400/90 pl-4" style="animation-delay: 0.9s">
          curl: (404) Not Found
        </div>
        <div class="terminal-line text-text-muted pl-4 text-xs" style="animation-delay: 1.1s">
          &gt; The requested resource does not exist on this server.
        </div>

        <!-- Line 3 — second prompt -->
        <div class="terminal-line mt-2" style="animation-delay: 1.5s">
          <span class="text-text-muted">┌──(</span><span class="text-green">m3m1g㉿sec</span><span class="text-text-muted">)-[~]</span>
        </div>
        <div class="terminal-line" style="animation-delay: 1.7s">
          <span class="text-text-muted">└─$</span> <span class="text-text">echo $?</span>
        </div>
        <div class="terminal-line text-green" style="animation-delay: 2.0s">
          404
        </div>

        <!-- Line 4 — suggestion -->
        <div class="terminal-line mt-2" style="animation-delay: 2.4s">
          <span class="text-text-muted">┌──(</span><span class="text-green">m3m1g㉿sec</span><span class="text-text-muted">)-[~]</span>
        </div>
        <div class="terminal-line" style="animation-delay: 2.6s">
          <span class="text-text-muted">└─$</span>
          <a
            href="/"
            class="text-green hover:underline underline-offset-2 ml-1 transition-opacity hover:opacity-80"
          >cd ~</a>
          <span class="text-text-muted ml-2 text-xs"># back to home</span>
          <span class="cursor-blink text-green ml-1">_</span>
        </div>

      </div>

      <!-- Helper text below terminal -->
      <p class="text-center text-text-muted text-xs mt-6">
        Page not found —
        <a href="/" class="text-green hover:underline underline-offset-2 transition-opacity hover:opacity-80">
          return to homepage
        </a>
      </p>

    </div>
  </section>
</Layout>
