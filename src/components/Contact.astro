<!-- ── Contact Section ── -->
<section id="contact" class="py-20 sm:py-28">
  <div class="max-w-2xl mx-auto px-4 sm:px-6">
    <div class="reveal">
      <p class="text-green text-sm font-mono mb-2">// contact</p>
      <h2 class="font-display font-bold text-2xl sm:text-3xl mb-3">Contacto</h2>
      <p class="text-text-muted mb-10">
        ¿Tienes un proyecto en mente o necesitas una auditoría? Escríbeme.
      </p>
    </div>

    <!-- Form (action ready for Formspree — replace YOUR_FORM_ID) -->
    <form
      action="https://formspree.io/f/YOUR_FORM_ID"
      method="POST"
      class="reveal space-y-5"
    >
      <div>
        <label for="name" class="block text-sm text-text-muted mb-1.5">Nombre</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full bg-surface border border-border rounded px-4 py-3 text-sm text-text placeholder-text-muted/50 focus:outline-none focus:border-green transition-colors"
          placeholder="Tu nombre"
        />
      </div>

      <div>
        <label for="email" class="block text-sm text-text-muted mb-1.5">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full bg-surface border border-border rounded px-4 py-3 text-sm text-text placeholder-text-muted/50 focus:outline-none focus:border-green transition-colors"
          placeholder="tu@email.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm text-text-muted mb-1.5">Mensaje</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full bg-surface border border-border rounded px-4 py-3 text-sm text-text placeholder-text-muted/50 focus:outline-none focus:border-green transition-colors resize-none"
          placeholder="¿En qué puedo ayudarte?"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full sm:w-auto px-8 py-3 bg-green text-bg font-bold text-sm rounded hover:bg-green-dim transition-colors duration-200 cursor-pointer"
      >
        Enviar mensaje
      </button>
    </form>

    <!-- Contact links -->
    <div class="reveal flex flex-col sm:flex-row items-center justify-center gap-6 mt-12 pt-8 border-t border-border">
      <a href="mailto:mapmapmaptema@proton.me" class="flex items-center gap-2 text-sm text-text-muted hover:text-green transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        mapmapmaptema@proton.me
      </a>
